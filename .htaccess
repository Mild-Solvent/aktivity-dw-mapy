# aktivity-dw-mapy — Apache routing for Websupport.
#
# Two jobs:
#   1. Map /api/<route> → api/<handler>.php (mirrors Vercel's filesystem routing).
#   2. SPA fallback: anything that isn't a real file/dir and isn't under /api/
#      → /index.html (so Vue Router in history mode works on deep links).

# /api/trails and /api/roles are also real directories on disk. mod_dir would
# see the directory first and 301 to /api/trails/, which none of the rules
# below match — so the API answered redirects instead of JSON. Turning
# DirectorySlash off lets the rewrites claim those paths. MultiViews is off for
# the same class of reason: it would try to guess api/trails.php.
DirectorySlash Off
Options -Indexes -MultiViews

# This is a static SPA: index.html is the only entry point. Stated explicitly
# because Websupport drops its own placeholder index.php into a new service's
# document root, and the default DirectoryIndex prefers .php -- which served
# the "Na tejto doméne zatiaľ nič nie je" page at / while every deep link
# correctly rendered the app.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── API routing ────────────────────────────────────────────────────────
  # id.php / email.php recover their path segment from REDIRECT_URL.
  #
  # [END], not [L]. In .htaccess context [L] only ends the current pass --
  # mod_rewrite then feeds the rewritten path through these rules again, so
  # /api/trails became api/trails/index.php, which matched the id rule on the
  # second pass and asked for a trail called "index.php". [END] stops rewriting
  # outright (Apache 2.4+).

  RewriteRule ^api/auth/register$         api/auth/register.php        [END,QSA]
  RewriteRule ^api/auth/login$            api/auth/login.php           [END,QSA]
  RewriteRule ^api/auth/logout$           api/auth/logout.php          [END,QSA]
  RewriteRule ^api/auth/me$               api/auth/me.php              [END,QSA]
  RewriteRule ^api/auth/forgot-password$  api/auth/forgot-password.php [END,QSA]
  RewriteRule ^api/auth/reset-password$   api/auth/reset-password.php  [END,QSA]
  RewriteRule ^api/auth/change-password$  api/auth/change-password.php [END,QSA]

  RewriteRule ^api/roles$          api/roles/index.php   [END,QSA]
  RewriteRule ^api/roles/(.+)$     api/roles/email.php   [END,QSA]

  # The trails your account has liked. A top-level path rather than
  # /api/trails/liked, which the catch-all id rule below would otherwise
  # shadow — and which would collide with a trail whose slug were "liked".
  RewriteRule ^api/likes$          api/likes.php         [END,QSA]

  RewriteRule ^api/trails$         api/trails/index.php  [END,QSA]
  # MUST stay above the catch-all: otherwise "<id>/like" is captured by (.+)
  # and id.php looks for a trail literally named "<id>/like".
  RewriteRule ^api/trails/([^/]+)/like$  api/trails/like.php [END,QSA]
  RewriteRule ^api/trails/(.+)$    api/trails/id.php     [END,QSA]

  RewriteRule ^api/upload$         api/upload.php        [END,QSA]

  # ── SPA fallback ───────────────────────────────────────────────────────
  # Match anything that is NOT:
  #   - under /api/         (handled above)
  #   - an existing file    (Vite JS/CSS, /assets, /tracks uploads)
  #   - an existing dir
  # and rewrite it to index.html so Vue Router can take over.
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ── Security: block direct PHP access to non-route files ─────────────────
# Nobody should ever fetch api/bootstrap.php or api/_lib/*.php directly.
<FilesMatch "^(bootstrap|config)\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^api/_lib/ - [F,L]
</IfModule>

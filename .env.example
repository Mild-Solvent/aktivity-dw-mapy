# ──────────────────────────────────────────────────────────────
# Server-side (used by /api functions on Vercel — NOT exposed to the client)
# Set these in the Vercel dashboard → Project → Settings → Environment Variables.
# KV_REST_API_URL / KV_REST_API_TOKEN and BLOB_READ_WRITE_TOKEN are
# auto-injected when you create KV (Upstash) and Blob stores in the dashboard.
# ──────────────────────────────────────────────────────────────

# Bootstrap admin — always treated as role=admin, no KV row required.
ADMIN_BOOTSTRAP_EMAIL=deletezajac@gmail.com

# Random 32+ bytes used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=<random 32+ bytes hex string>

# Cookie name for the auth session (optional, defaults to "dw_session").
# SESSION_COOKIE=dw_session

# ──────────────────────────────────────────────────────────────
# Client-side (VITE_ prefix — inlined into the SPA bundle at build time)
# None required for the Vercel backend swap — the SPA talks to /api/*,
# which is same-origin, so no URLs or keys are needed in the client.
# ──────────────────────────────────────────────────────────────
